{
  "name": "pact-contract-companion",
  "displayName": "Pact Contract Companion",
  "description": "Lists consumer-provider Pact contract files in your workspace and flags interactions with a missing provider state or a duplicate description+state pair. No data leaves your editor.",
  "version": "0.1.0",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "pact",    "contract-testing",    "microservices",    "consumer-driven"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-pact-contract-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-pact-contract-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "pactContractCompanion.contracts",
          "name": "Pact Contracts"
        }
      ]
    },
    "commands": [
      {
        "command": "pactContractCompanion.refresh",
        "title": "Pact Contract Companion: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pactContractCompanion.refresh",
          "when": "view == pactContractCompanion.contracts",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Pact Contract Companion",
      "properties": {
        "pactContractCompanion.contractGlob": {
          "type": "string",
          "default": "**/pacts/**/*.json",
          "description": "Glob pattern for Pact contract JSON files to scan."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
